# Copy to backend/.env and fill in real local values. Never commit backend/.env.
# See docs/LOCAL_DEVELOPMENT.md for the full setup walkthrough.

# ── Auth (Prisma-backed: User, FarmProfile, and the other legacy models) ──
# Local dev Postgres, e.g. from `docker compose up -d postgres` at the repo root.
# NEVER a real/production connection string.
DATABASE_URL="postgresql://yieldai:yieldai_dev_only@localhost:5432/yieldai_dev"

JWT_SECRET="replace-with-a-long-random-local-dev-only-value"
JWT_EXPIRES_IN="7d"

PORT=3001

# ── Forecast data source ───────────────────────────────────────────────
# 'postgres' | 'csv'. If unset: defaults to 'postgres' when DATABASE_URL is
# set, else 'csv'. IMPORTANT: DATABASE_URL above is also used for
# auth/farms — if you've set it but haven't run `npm run db:migrate` +
# ingested Telangana data yet, explicitly set FORECAST_DATA_SOURCE=csv
# here, or forecast/recommendation routes will fail readiness (by design —
# see docs/POSTGRES_FORECAST_MIGRATION_PLAN.md; there is no silent fallback
# to CSV when Postgres is configured but not ready).
FORECAST_DATA_SOURCE=csv

# Only read when FORECAST_DATA_SOURCE=csv (or defaulted to it). Path to
# forecast_lookup_all_commodities.csv; defaults to <repo root>/data/... if unset.
# FORECAST_CSV_PATH=/absolute/path/to/forecast_lookup_all_commodities.csv

# Max pg.Pool connections for the analytical (market_prices/price_forecasts) pool.
# PG_POOL_MAX=10
